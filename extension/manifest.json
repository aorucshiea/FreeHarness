{
  "manifest_version": 3,
  "name": "WebHarness — 网页AI本地工具执行器",
  "version": "0.6.0",
  "description": "捕捉网页AI输出的工具调用，在你电脑上执行，并把结果自动发回，让免费网页AI变成能干活的Agent。",
  "permissions": ["storage", "scripting", "tabs", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebHarness"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*",
        "https://chat.deepseek.com/*",
        "https://tongyi.aliyun.com/*",
        "https://www.tongyi.com/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://agentmore.chatglm.cn/*",
        "https://*.chatglm.cn/*",
        "https://z.ai/*",
        "https://chat.z.ai/*",
        "https://www.z.ai/*",
        "https://gemini.google.com/*",
        "https://yuanbao.tencent.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["protocol.js", "adapters.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
