{
  "manifest_version": 3,
  "name": "FreeHarness - 解放网页 AI",
  "version": "0.9.10",
  "description": "解放网页 AI：把免费的网页版 AI（DeepSeek/GLM/ChatGPT 等）变成能操作你电脑的 Agent——执行命令、读写文件、截图看图、点鼠标，零 API 成本。",
  "permissions": ["storage", "scripting", "tabs", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreeHarness - 解放网页 AI"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*",
        "https://chat.deepseek.com/*",
        "https://tongyi.aliyun.com/*",
        "https://www.tongyi.com/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://agentmore.chatglm.cn/*",
        "https://*.chatglm.cn/*",
        "https://z.ai/*",
        "https://chat.z.ai/*",
        "https://www.z.ai/*",
        "https://gemini.google.com/*",
        "https://yuanbao.tencent.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["protocol.js", "adapters.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
